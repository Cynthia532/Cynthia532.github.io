{
  "name": "zhixin-room", "private": true, "version": "0.1.0", "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && vite build && node ../scripts/room-manifest.mjs",
    "test": "playwright test",
    "test:unit": "playwright test --project=logic",
    "test:browser": "playwright test --project=desktop --project=mobile"
  },
  "dependencies": { "three": "0.186.1" },
  "devDependencies": {
    "@playwright/test": "1.63.0", "@types/node": "26.6.3", "@types/three": "0.186.0",
    "typescript": "5.9.3", "vite": "8.3.1"
  }
}
